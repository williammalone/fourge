# Live presence (OPTIONAL).
# Without these, Fourge runs fully on the zero-backend async share model.
# To see when an invited friend is *currently playing*:
#   1. Create a free project at https://supabase.com
#   2. Project Settings -> API: copy the Project URL and the anon/public key
#   3. Paste them below (for local dev), and add the same two as GitHub Actions
#      repository secrets (Settings -> Secrets and variables -> Actions) so the
#      deployed build picks them up.
# The anon key is meant to be public/client-side; no database or tables are used
# (presence is an ephemeral realtime channel). Only counts/score are broadcast,
# never the words you've found.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
